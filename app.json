{
  "expo": {
    "name": "Paraölçer",
    "slug": "paraolcer",
    "description": "Senin enflasyonun kaç? Harcamandan hesaplar, birikimini ona karşı ölçer.",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "paraolcer",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#F4F6F9",
    "ios": {
      "icon": "./assets/images/icon.png",
      "privacyManifests": {
        "NSPrivacyTracking": false,
        "NSPrivacyTrackingDomains": [],
        "NSPrivacyAccessedAPITypes": [
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryUserDefaults",
            "NSPrivacyAccessedAPITypeReasons": [
              "CA92.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryFileTimestamp",
            "NSPrivacyAccessedAPITypeReasons": [
              "C617.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategorySystemBootTime",
            "NSPrivacyAccessedAPITypeReasons": [
              "35F9.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryDiskSpace",
            "NSPrivacyAccessedAPITypeReasons": [
              "E174.1"
            ]
          }
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0F1B2D",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "server",
      "name": "Paraölçer",
      "shortName": "Paraölçer",
      "themeColor": "#0F1B2D",
      "backgroundColor": "#F4F6F9",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0F1B2D",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 120
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-sharing",
      "expo-font",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Paraölçer, birikimlerini korumak için Face ID ile kilit açmayı kullanır."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "feedUrl": "https://ofzorbaci.github.io/Paraolcer/feed.json",
      "revenuecat": {
        "testApiKey": "test_UaGMsZCByupqMnOTUNwVsljFriq",
