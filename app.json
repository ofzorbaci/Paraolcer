{
  "expo": {
    "name": "Paraölçer",
    "slug": "paraolcer",
    "description": "Alım gücünü ölç: birikiminin enflasyon karşısındaki gerçek getirisi.",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "paraolcer",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#F4F6F9",
    "ios": {
      "icon": "./assets/images/icon.png"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0F1B2D",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "server",
      "name": "Paraölçer",
      "shortName": "Paraölçer",
      "themeColor": "#0F1B2D",
      "backgroundColor": "#F4F6F9",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0F1B2D",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 120
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-sharing",
      "expo-font",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Paraölçer, birikimlerini korumak için Face ID ile kilit açmayı kullanır."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "feedUrl": "https://ofzorbaci.github.io/Paraolcer/feed.json",
      "revenuecat": {
        "testApiKey": "test_UaGMsZCByupqMnOTUNwVsljFriq",
        "iosApiKey": "",
        "androidApiKey": "",
        "entitlement": "paraölçer_premium"
      },
      "legal": {
        "termsUrl": "https://www.apple.com/legal/internet-services/itunes/dev/stdeula/",
        "privacyUrl": "https://ofzorbaci.github.io/Paraolcer/gizlilik.html"
      }
    }
  }
}
